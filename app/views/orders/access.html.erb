<!DOCTYPE html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8">
    <title></title>
  </head>
  <body>
    <%= render 'include/navbar' %>
    <div class="row">
      <div class="col-12 col-lg-5">

      </div>
      <div class="col-12 col-lg-2">
        <div class="shadow-lg p-3 mb-5 bg-body-tertiary rounded">
          <center>
            <h5>Введите пин-код для доступа к заказу</h5>
              <%= form_with(model: @order, url: verify_order_path(@order), method: :patch, local: true) do |f|%>
                <%= f.text_field :pin_code, class:"form-control form-control-sm" %>
                  <br>
                <%= f.button class:"btn btn-info btn-sm" do %>
                  Войти
                <% end %>
              <% end %>
            <% flash.each do |key, message| %>
              <div class="alert alert-<%= key %>">
                <%= message %>
              </div>
            <% end %>
          <center>
        </div>
      </div>
      <div class="col-12 col-lg-5">

      </div>
    </div>

  </body>
</html>
