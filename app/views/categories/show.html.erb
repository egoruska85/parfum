<!DOCTYPE html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8">
    <title></title>
  </head>
  <body style="background: #F5F5DC;">
    <%= render 'include/navbar' %>
    <div class="container">
      <div class="row">
        <div class="col-12 col-lg-2">
          <div class="shadow-lg p-3 mb-5 bg-body-tertiary rounded">
            <center style="font-size: 12px;">
              <%= @gender.name if params[:locale] != true and params[:locale] != 'en' and params[:locale] != 'tm' and params[:locale] != 'ru' %>
              <%= @gender.name if params[:locale] == 'ru' %>
              <%= @gender.name_tm if params[:locale] == 'tm' %>
            </center>
            <hr>
            <div class="row">
              <% @categories.each do |category| %>
              <div class="col-6 col-lg-12">
                <%= link_to category_path(category), class:"btn" do %>
                <%= category.name if params[:locale] != true and params[:locale] != 'en' and params[:locale] != 'tm' and params[:locale] != 'ru' %>
                <%= category.name if params[:locale] == 'ru' %>
                <%= category.name_tm if params[:locale] == 'tm' %>
                <% end %>
              </div>
              <% end %>
            </div>





          </div>
        </div>
        <div class="col-12 col-lg-8">
          <div class="shadow-lg p-3 mb-5 bg-body-tertiary rounded">
            <div class="row">
              <% @products.each do |product| %>
                <div class="col-6 col-lg-3">
                  <center>
                    <div class="card" style="min-height: 280px;">
                      <img src="<%= rails_blob_url(product.image) %>" class="card-img-top" alt="..." style="width: absolute; height: 150px;">
                      <div class="card-body">
                        <hr>
                          <%= link_to product_path(product), class:'nav-link' do %>
                            <h6 class="card-title" style="font-size: 12px;"><%= product.name %></h6>
                          <% end %>
                        <hr>
                        <%= form_with(url: cart_add_path) do |f|%>
                          <%= f.hidden_field :id, value: product.id %>
                          <div class="row">
                            <div class="col-4 col-lg-4">
                              <%= f.number_field :quantity, value: 0, min: 1, style:"width: 60px;", class:"form-control" %>
                            </div>
                            <div class="col-6">
                              <%= f.submit "+", class:"btn btn-success" %>
                            </div>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  </center>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>




    </div>
  </body>
</html>
